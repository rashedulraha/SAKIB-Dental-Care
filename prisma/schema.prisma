datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Appointment {
  id              String   @id @default(uuid())
  serialId        String   @unique
  patientName     String
  patientPhone    String
  patientAge      String?
  branchKey       String   @default("nawhata") // "nawhata" | "city"
  serviceId       Int?
  serviceTitle    String
  appointmentDate String   // "YYYY-MM-DD"
  timeSlot        String
  patientNotes    String?
  doctorNotes     String?
  status          String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([appointmentDate])
  @@index([patientPhone])
  @@index([status])
}

model ClinicSetting {
  id        String   @id @default(uuid())
  key       String   @unique 
  value     String   @db.Text 
  updatedAt DateTime @updatedAt
}

model DentalService {
  id          Int      @id
  titleEn     String
  titleBn     String
  category    String   // diagnostic, restorative, cosmetic, ortho-surgical
  shortDescEn String   @db.Text
  shortDescBn String   @db.Text
  durationEn  String
  durationBn  String
  techEn      String
  techBn      String
  careTipEn   String   @db.Text
  careTipBn   String   @db.Text
  icon        String   @default("ph-tooth")
  color       String   @default("sky")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model AdminOtpChallenge {
  email      String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime

  @@index([expiresAt])
}
