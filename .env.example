# =============================================================================
# SAKIB DENTAL CARE — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Application Runtime
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLINIC_NAME="Sakib Dental Care"
NEXT_PUBLIC_CLINIC_NAME_BN="সাকিব ডেন্টাল কেয়ার"

# PostgreSQL Database (Prisma ORM)
# Transaction pooler URL (e.g. Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/sakib_dental_db?schema=public"
# Direct connection URL (used for migrations if using connection pooler)
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/sakib_dental_db?schema=public"

# Authentication & Cryptographic Security
# Generate using: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_64_character_hex_or_base64_string"
JWT_EXPIRES_IN="7d"

# Clinic Default Communication Hotlines
NEXT_PUBLIC_WHATSAPP_NUMBER="8801733054717"
NEXT_PUBLIC_HOTLINE_PHONE="01733-054717"

# Admin sign-in credentials (required for the hidden admin login flow)
ADMIN_EMAIL="sakibdentalcare1@gmail.com"
ADMIN_PASSWORD="replace_with_a_unique_long_admin_password"

# SMTP settings for one-time admin verification codes
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="admin@example.com"
SMTP_PASSWORD="replace_with_your_smtp_or_app_password"
SMTP_FROM_EMAIL="admin@example.com"
SMTP_FROM_NAME="Sakib Dental Care"

# Initial Super Admin Seed Credentials (used by npx prisma db seed)
INITIAL_ADMIN_EMAIL="admin@sakibdental.com"
INITIAL_ADMIN_PASSWORD="SecureAdminPassword123!"
INITIAL_ADMIN_PHONE="01733054717"
INITIAL_ADMIN_NAME="Dr. Sakib"

# Cloud Storage / Media Uploads (Optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
